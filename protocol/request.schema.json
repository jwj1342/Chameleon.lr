{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chameleon.lr/schemas/request.schema.json",
  "title": "Chameleon fit request",
  "type": "object",
  "required": ["schema_version", "request_id", "reference", "targets", "options"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "reference": { "$ref": "#/$defs/photo" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/photo" }
    },
    "options": {
      "type": "object",
      "required": ["strength", "adapt_exposure", "adapt_white_balance"],
      "properties": {
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "adapt_exposure": { "type": "boolean" },
        "adapt_white_balance": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "photo": {
      "type": "object",
      "required": ["id", "preview_path", "develop_settings", "metadata"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "preview_path": { "type": "string", "minLength": 1 },
        "develop_settings": { "type": "object" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
